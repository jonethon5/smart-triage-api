# Copie para .env e troque os valores: cp .env.example .env

# Lidas pela imagem do Postgres para criar o usuário e o banco na primeira subida
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha
POSTGRES_DB=smart_triage

# Dentro do Docker o host é o nome do serviço (postgres) na porta 5432.
# Rodando fora do Docker, use localhost:5434
DATABASE_URL=postgresql://postgres:troque-por-uma-senha@postgres:5432/smart_triage

JWT_SECRET=troque-por-um-segredo-longo
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo
